# Copy to /.env (repo root) for local development.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://fenix:fenix@localhost:5432/fenix
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=
# Outbound proxy for the Bot API where Telegram is blocked, e.g. socks5://user:pass@host:1080
TELEGRAM_PROXY_URL=
# Mini App URL; in the Telegram test environment plain http://127.0.0.1:5173 works
WEBAPP_URL=
