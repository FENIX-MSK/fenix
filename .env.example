# Copy to /.env (repo root) for local development.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://fenix:fenix@localhost:5432/fenix
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=
# polling locally, webhook in production
TELEGRAM_BOT_MODE=polling
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Mini App URL; in the Telegram test environment plain http://127.0.0.1:5173 works
WEBAPP_URL=
