# /opt/fenix/.env on the VPS. Never commit real values.
IMAGE_TAG=latest
# Set by the deploy workflow from the `production` environment variables
# (SITE_ADDRESS, SITE_DOMAIN, WEBAPP_URL); the values here are only the initial ones.
# Caddy serves every address listed (quoted, comma + space separated).
SITE_ADDRESS="fenix.kitexp.ru, 84-54-56-12.sslip.io"
# The primary host: Grafana's public URL.
SITE_DOMAIN=fenix.kitexp.ru
# Where the bot's buttons open the Mini App.
WEBAPP_URL=https://fenix.kitexp.ru

TELEGRAM_BOT_TOKEN=
# Without "@"; optional — asked from Telegram when empty.
TELEGRAM_BOT_USERNAME=
# The first staff member (see docs, story 2.1); set from the deploy workflow variable.
BOOTSTRAP_STAFF_TELEGRAM_USERNAME=
# Outbound proxy for the Bot API where Telegram is blocked, e.g. socks5://user:pass@host:1080
TELEGRAM_PROXY_URL=

POSTGRES_PASSWORD=
MINIO_ROOT_USER=fenix
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
