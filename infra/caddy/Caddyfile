{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	# Dish and cafe photos from Garage's website endpoint (AD-12); objects are immutable,
	# so they carry a year-long Cache-Control set at upload.
	handle_path /media/* {
		reverse_proxy garage:3902 {
			header_up Host media
		}
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Mini App: single-page app, unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
